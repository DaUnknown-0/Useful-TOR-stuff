<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <Version>1.3.3</Version>
        <Description>TOR - Forgotten Fixes - Bloody-modifier lag throttle and gated client-side Snitch reveal/map/HUD reimplementation</Description>
        <Authors>DaUnknown-0</Authors>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <Platforms>AnyCPU</Platforms>
        <AssemblyName>UsefulTORStuff</AssemblyName>
    </PropertyGroup>

    <!-- Own button icons + sound cues (generated by TOR Mod\Assets\AssetGen), loaded by UTSAssets.
         Explicit LogicalNames so the lookup never depends on the root-namespace default. -->
    <ItemGroup>
        <EmbeddedResource Include="Resources\uts_unshield.png" LogicalName="UsefulTORStuff.Resources.uts_unshield.png" />
        <EmbeddedResource Include="Resources\uts_selflimp.png" LogicalName="UsefulTORStuff.Resources.uts_selflimp.png" />
        <EmbeddedResource Include="Resources\uts_mixup.png" LogicalName="UsefulTORStuff.Resources.uts_mixup.png" />
        <EmbeddedResource Include="Resources\uts_bombcancel.png" LogicalName="UsefulTORStuff.Resources.uts_bombcancel.png" />
        <EmbeddedResource Include="Resources\uts_revenger.png" LogicalName="UsefulTORStuff.Resources.uts_revenger.png" />
        <EmbeddedResource Include="Resources\uts_reshield.raw" LogicalName="UsefulTORStuff.Resources.uts_reshield.raw" />
        <EmbeddedResource Include="Resources\uts_limp.raw" LogicalName="UsefulTORStuff.Resources.uts_limp.raw" />
        <EmbeddedResource Include="Resources\uts_mixup.raw" LogicalName="UsefulTORStuff.Resources.uts_mixup.raw" />
        <EmbeddedResource Include="Resources\uts_bombcancel.raw" LogicalName="UsefulTORStuff.Resources.uts_bombcancel.raw" />
        <EmbeddedResource Include="Resources\uts_revenger.raw" LogicalName="UsefulTORStuff.Resources.uts_revenger.raw" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2024.10.29" />
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" />
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.697" />
        <PackageReference Include="Reactor" Version="2.3.1" />
    </ItemGroup>

    <!-- TOR DLL location: defaults to the local build, overridable in CI via -p:TheOtherRolesDll=... -->
    <PropertyGroup>
        <TheOtherRolesDll Condition="'$(TheOtherRolesDll)' == ''">..\TheOtherRoles-main\TheOtherRoles-main\TheOtherRoles\bin\Debug\net6.0\TheOtherRoles.dll</TheOtherRolesDll>
    </PropertyGroup>

    <!-- Reference TOR as hard dependency (needed for the in-game CustomOption + Sheriff/win statics) -->
    <ItemGroup>
        <Reference Include="TheOtherRoles">
            <HintPath>$(TheOtherRolesDll)</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <Target Name="CopyCustomContent" AfterTargets="AfterBuild" Condition="Exists('$(AmongUsLatest)/BepInEx/plugins/')">
        <Message Text="Copying UsefulTORStuff to BepInEx plugins" />
        <Copy SourceFiles="$(ProjectDir)\bin\$(Configuration)\net6.0\UsefulTORStuff.dll" DestinationFolder="$(AmongUsLatest)/BepInEx/plugins/" />
    </Target>
</Project>
